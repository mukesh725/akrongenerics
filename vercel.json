{
  "version": 2,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/become-a-customer",
      "destination": "https://server.akrongenerics.com/become_a_customer.php",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/google69671ac97c100bcf.html",
      "destination": "/google69671ac97c100bcf.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(admin|dashboard|print-dossier|src/pages/.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
