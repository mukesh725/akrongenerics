# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Storage Directories (Relative to backend/ or Absolute)
SUBMISSIONS_PATH=data/submissions
TEMPLATES_PATH=templates

# Security & CORS Settings
CORS_ORIGIN=*
SESSION_SECRET=change-this-in-production

# ==============================================================================
# SECURE IN-HOUSE EMAIL NOTIFICATIONS (DIRECT TO YOUR INBOX - ZERO 3RD PARTIES)
# ==============================================================================
NOTIFICATION_RECIPIENT=info@akrongenerics.com

# Example 1: Microsoft 365 / Exchange Online
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=notifications@akrongenerics.com
# SMTP_PASS=YourM365AppPassword

# Example 2: Google Workspace
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@akrongenerics.com
# SMTP_PASS=YourGoogleAppPassword16Chars

# Example 3: Private Corporate Mail Server / cPanel
# SMTP_HOST=mail.akrongenerics.com
# SMTP_PORT=465
# SMTP_USER=info@akrongenerics.com
# SMTP_PASS=YourPrivateEmailPassword
